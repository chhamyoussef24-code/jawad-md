{
  "name": "jawad-md",
  "version": "7.0.0",
  "description": "JAWAD-MD, a Multi Device Whatsapp Bot",
  "main": "./index.js",
  "type": "commonjs",
  "engines": {
    "node": "18.x"
  },
  "scripts": {
    "start": "pm2 start index.js --deep-monitoring --attach --name JAWAD-MD",
    "stop": "pm2 stop JAWAD-MD",
    "restart": "pm2 restart JAWAD-MD"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.5"
  }
}
